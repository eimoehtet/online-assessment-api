DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
JWT_SECRET="replace-with-a-long-random-secret"
REFRESH_TOKEN_PEPPER="replace-with-a-different-long-random-secret"
JWT_ISSUER="light-lms-api"
JWT_AUDIENCE="light-lms-web"
FRONTEND_ORIGINS="http://localhost:5173"
NODE_ENV="development"
# Local development: leave these unset (defaults: Secure=false, SameSite=lax).
# Cross-site production frontend/API: uncomment both settings.
# AUTH_COOKIE_SECURE="true"
# AUTH_COOKIE_SAME_SITE="none"
